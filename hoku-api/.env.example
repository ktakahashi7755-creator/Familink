# Hoku API 環境変数のサンプル。実際の値は .env に書く（.env は .gitignore 済み）。
# LLM API キーをコードに直書きしないこと（docs/security-auth-notes.md 参照）。

# LLM プロバイダ（任意。未設定ならルールベース分類のみで動作する）
HOKU_LLM_PROVIDER=
HOKU_LLM_API_KEY=
HOKU_LLM_MODEL=gpt-4o-mini

# API アクセス制御（任意。設定すると X-Hoku-Key ヘッダ必須になる）
HOKU_API_KEY=

# CORS 許可オリジン（カンマ区切り）
HOKU_CORS_ORIGINS=https://ktakahashi7755-creator.github.io
